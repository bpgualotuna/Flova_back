{
  "info": {
    "name": "Flova Backend - Pruebas de API (Defensa David Rodríguez)",
    "_postman_id": "7b4c6b77-3e5f-4a39-9d58-94dfa18cb490",
    "description": "Colección oficial para la defensa del módulo de Médicos y Horarios de Atención (David Rodríguez) en Flova Backend. Incluye autenticación con JWT, autorización basada en roles (RBAC), pruebas CRUD exitosas, validaciones de negocio negativas (400, 401, 403, 404, 409), baja lógica y compatibilidad de rutas duales.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "00 - Health Check",
      "item": [
        {
          "name": "API Health Status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "health"
              ]
            },
            "description": "Verifica que el servidor esté activo y respondiendo correctamente."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code es 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Responde con status ok', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.status).to.eql('ok');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "01 - Autenticación (Login & JWT)",
      "item": [
        {
          "name": "1. Login Administrador (Captura token_admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{admin_user}}\",\n  \"password\": \"{{admin_password}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Inicia sesión con credenciales de Administrador y guarda automáticamente el token JWT en 'token_admin'."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code es 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Retorna token JWT de admin', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.have.property('token');",
                  "    pm.expect(json.user.role).to.eql('admin');",
                  "    pm.environment.set('token_admin', json.token);",
                  "    console.log('Token Admin guardado correctamente');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Login Médico (Captura token_medico)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{medico_user}}\",\n  \"password\": \"{{medico_password}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Inicia sesión con credenciales de Médico y guarda el token JWT en 'token_medico'."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code es 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Retorna token JWT con rol medico', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.have.property('token');",
                  "    pm.expect(json.user.role).to.eql('medico');",
                  "    pm.environment.set('token_medico', json.token);",
                  "    console.log('Token Médico guardado correctamente');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "3. Login Paciente (Captura token_paciente)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{paciente_user}}\",\n  \"password\": \"{{paciente_password}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Inicia sesión con usuario Paciente para validar restricciones RBAC en 'token_paciente'."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code es 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Retorna token JWT con rol paciente', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.have.property('token');",
                  "    pm.expect(json.user.role).to.eql('paciente');",
                  "    pm.environment.set('token_paciente', json.token);",
                  "    console.log('Token Paciente guardado correctamente');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 - Médicos (David Rodríguez - Flujo Positivo)",
      "item": [
        {
          "name": "1. Listar Médicos Activos",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/doctors",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "doctors"
              ]
            },
            "description": "Lista todos los médicos activos en el sistema con sus datos completos y mapeo dual."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code es 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Retorna lista de médicos con mapeo dual', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(Array.isArray(json)).to.be.true;",
                  "    if (json.length > 0) {",
                  "        var first = json[0];",
                  "        pm.expect(first).to.have.property('specialty');",
                  "        pm.expect(first).to.have.property('especialidad');",
                  "        pm.expect(first).to.have.property('licenseNumber');",
                  "        pm.expect(first).to.have.property('numeroLicencia');",
                  "        pm.expect(first.active).to.be.true;",
                  "    }",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Consultar Médico por ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/doctors/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "doctors",
                "1"
              ]
            },
            "description": "Obtiene los detalles del médico ID 1 incluyendo su usuario y sus horarios de atención activos."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code es 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Retorna médico con sus horarios asociados', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.id).to.eql(1);",
                  "    pm.expect(json).to.have.property('workSchedule');",
                  "    pm.expect(json).to.have.property('horarioAtencion');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "3. Filtrar Médicos por Especialidad",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/doctors/specialty/Fisioterapia",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "doctors",
                "specialty",
                "Fisioterapia"
              ]
            },
            "description": "Filtra médicos activos por su especialidad médica."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code es 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Todos los médicos filtrados son de Fisioterapia', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(Array.isArray(json)).to.be.true;",
                  "    json.forEach(function(doc) {",
                  "        pm.expect(doc.specialty).to.eql('Fisioterapia');",
                  "    });",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "4. Crear Nuevo Médico (Admin - 201 Created)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token_admin}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": 999,\n  \"especialidad\": \"Neurología y Rehabilitación\",\n  \"numeroLicencia\": \"MSP-AUTO-{{$timestamp}}\",\n  \"calificacion\": 4.9,\n  \"pacientesAtendidos\": 25\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/doctors",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "doctors"
              ]
            },
            "description": "Crea un nuevo perfil médico vinculado a un usuario con rol 'medico'. Usa el script de pre-solicitud para garantizar que exista un usuario médico disponible si se ejecuta de cero."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Si no existe un usuario médico nuevo, registra uno rápido o usa uno existente",
                  "var randomSuffix = Math.floor(Math.random() * 899999 + 100000);",
                  "var cedula = '17' + randomSuffix + '1';",
                  "pm.variables.set('temp_license', 'MSP-' + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Puede responder 201 si el usuario existe, o capturar el id creado",
                  "if (pm.response.code === 201) {",
                  "    var json = pm.response.json();",
                  "    pm.test('Médico creado con status 201 Created', function () {",
                  "        pm.expect(pm.response.code).to.eql(201);",
                  "        pm.expect(json).to.have.property('id');",
                  "        pm.environment.set('created_doctor_id', json.id);",
                  "    });",
                  "} else {",
                  "    pm.test('Respuesta esperada según estado de BD', function () {",
                  "        pm.expect([201, 400, 404, 409]).to.include(pm.response.code);",
                  "    });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "5. Actualizar Médico (Admin - 200 OK)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token_admin}}",
                  "type": "string"
                }
              ]
            },
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"especialidad\": \"Fisioterapia Deportiva y Avanzada\",\n  \"calificacion\": 5,\n  \"pacientesAtendidos\": 150\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/doctors/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "doctors",
                "1"
              ]
            },
            "description": "Actualiza los datos del médico ID 1 con token de Administrador."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code es 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Médico actualizado con éxito', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.have.property('doctor');",
                  "    pm.expect(json.doctor.specialty).to.eql('Fisioterapia Deportiva y Avanzada');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "03 - Médicos (Validaciones y Casos Negativos)",
      "item": [
        {
          "name": "1. Error 401: Crear Médico sin Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": 1,\n  \"especialidad\": \"Cardiología\",\n  \"numeroLicencia\": \"LIC-NO-AUTH\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/doctors",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "doctors"
              ]
            },
            "description": "Intento no autenticado de crear un médico. Debe retornar 401 Unauthorized."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code es 401 Unauthorized', function () {",
                  "    pm.response.to.have.status(401);",
                  "});",
                  "pm.test('Retorna mensaje de token no provisto', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.have.property('error');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Error 403: Crear Médico con Rol Paciente",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token_paciente}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": 2,\n  \"especialidad\": \"Traumatología\",\n  \"numeroLicencia\": \"LIC-FORBIDDEN\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/doctors",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "doctors"
              ]
            },
            "description": "Usuario con rol paciente intenta crear un médico. RBAC debe bloquearlo con 403 Forbidden."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code es 403 Forbidden', function () {",
                  "    pm.response.to.have.status(403);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "3. Error 400: Asociar Usuario que no tiene Rol Médico",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token_admin}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": 1,\n  \"especialidad\": \"Pediatría\",\n  \"numeroLicencia\": \"LIC-INVALID-ROLE\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/doctors",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "doctors"
              ]
            },
            "description": "Intento de crear un médico usando un usuario cuyo rol es 'admin' o 'paciente'. Debe retornar 400 Bad Request."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code es 400 Bad Request o 409 si ya tiene perfil', function () {",
                  "    pm.expect([400, 409]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "4. Error 409: Crear Médico con Licencia Duplicada",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token_admin}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": 5,\n  \"especialidad\": \"Fisioterapia\",\n  \"numeroLicencia\": \"MSP-12345\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/doctors",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "doctors"
              ]
            },
            "description": "Valida la regla de unicidad del número de licencia médica. Debe retornar 409 Conflict."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code es 409 Conflict o 400/404', function () {",
                  "    pm.expect([400, 404, 409]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "5. Error 404: Consultar Médico Inexistente",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/doctors/99999",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "doctors",
                "99999"
              ]
            },
            "description": "Búsqueda de un médico que no existe en la base de datos."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code es 404 Not Found', function () {",
                  "    pm.response.to.have.status(404);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "6. Baja Lógica de Médico (DELETE - 200 OK)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token_admin}}",
                  "type": "string"
                }
              ]
            },
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/doctors/2",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "doctors",
                "2"
              ]
            },
            "description": "Aplica soft delete al médico ID 2 y desactiva en cascada sus horarios de atención para no romper citas históricas."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code es 200 OK o 404 si ya fue desactivado', function () {",
                  "    pm.expect([200, 404]).to.include(pm.response.code);",
                  "});",
                  "if (pm.response.code === 200) {",
                  "    pm.test('Confirma desactivación exitosa', function () {",
                  "        var json = pm.response.json();",
                  "        pm.expect(json.message).to.include('desactivado exitosamente');",
                  "    });",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "04 - Horarios de Atención (David Rodríguez - Flujo Positivo)",
      "item": [
        {
          "name": "1. Listar Horarios de un Médico",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/doctors/1/schedules",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "doctors",
                "1",
                "schedules"
              ]
            },
            "description": "Consulta los horarios de atención activos del médico ID 1."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code es 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Retorna horarios ordenados con horas válidas', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(Array.isArray(json)).to.be.true;",
                  "    if (json.length > 0) {",
                  "        var s = json[0];",
                  "        pm.expect(s).to.have.property('startTime');",
                  "        pm.expect(s).to.have.property('endTime');",
                  "        pm.expect(s).to.have.property('dayOfWeek');",
                  "        pm.environment.set('created_schedule_id', s.id);",
                  "    }",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Crear Nuevo Horario (Admin/Médico - 201 Created)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token_admin}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"diaSemana\": 6,\n  \"horaInicio\": \"08:00\",\n  \"horaFin\": \"13:00\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/doctors/1/schedules",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "doctors",
                "1",
                "schedules"
              ]
            },
            "description": "Registra un nuevo horario de atención los sábados para el médico ID 1."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code es 201 Created o 409 si ya existe', function () {",
